{
  "name": "spatial-astrology-explorer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "test": "vitest run",
    "validate:content": "tsx scripts/validate-content.ts",
    "test:watch": "vitest",
    "check": "svelte-check --tsconfig ./tsconfig.json && tsc --noEmit",
    "m0": "tsx scripts/m0-feasibility.ts",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src api scripts tests *.ts *.js",
    "format": "prettier --write src scripts tests *.ts *.js *.json *.html .github",
    "test:browser": "npm run build && node scripts/run-browser-tests.mjs"
  },
  "dependencies": {
    "geo-tz": "8.1.10",
    "moment-timezone": "0.6.5",
    "svelte": "5.57.2",
    "three": "0.186.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "24.12.0",
    "@types/three": "0.186.0",
    "eslint": "10.13.0",
    "eslint-plugin-svelte": "3.23.1",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "svelte-check": "4.7.7",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
