# Development and ordinary Vite builds use the same-origin /api routes by default.
# A separate HTTPS lookup service must be chosen before building a release:
# VITE_LOOKUP_BASE_URL=https://lookup.example

# Backend runtime variables. Do not prefix secrets with VITE_.
HOST=127.0.0.1
PORT=8080
GEOCODING_MODE=free
# GEOCODING_MODE=customer
# GEOCODING_API_KEY=backend-only-provider-key
# GEOCODING_MODE=disabled
LOOKUP_PER_CLIENT_PER_MINUTE=60
SEARCH_PER_MINUTE=60
SEARCH_PER_DAY=9000

# Public HTTPS deployment, behind one explicitly trusted local proxy:
# PUBLIC_ORIGIN=https://explorer.example
TRUST_PROXY=none
# TRUST_PROXY=loopback
# Direct TLS alternative (both required):
# HTTPS_CERT_FILE=/host-managed/fullchain.pem
# HTTPS_KEY_FILE=/host-managed/private-key.pem
# CORS_ORIGIN=https://separate-client.example
